#!/usr/bin/env bash
# Pre-commit hook: run all guardrail checks against the working tree.
# Enable once per clone: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
for check in check_loc check_hot_path check_gpio check_structure check_platform_guards check_bundle; do
  uv run "scripts/checks/$check.py"
done
