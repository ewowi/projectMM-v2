{
  "name": "resize-64",
  "description": "Reference pipeline then resize the grid straight to 64x64 (4096 pixels). Measures pixel-buffer reallocation at the large-panel size (mirrors v1 base-pipeline-64x64 intent with v2 modules).",
  "steps": [
    { "name": "add-layout",   "op": "add_module",  "id": "layout-0", "type": "layout" },
    { "name": "add-ripples",  "op": "add_module",  "id": "ripples-0", "type": "ripples" },
    { "name": "add-preview",  "op": "add_module",  "id": "preview-0", "type": "preview" },
    { "name": "add-artnet",   "op": "add_module",  "id": "artnet-0",  "type": "artnet-out" },
    { "name": "nest-ripples", "op": "reparent",    "id": "ripples-0", "parent_id": "layout-0" },
    { "name": "nest-preview", "op": "reparent",    "id": "preview-0", "parent_id": "ripples-0" },
    { "name": "nest-artnet",  "op": "reparent",    "id": "artnet-0",  "parent_id": "ripples-0",
      "measure": true },
    { "name": "resize-64w",   "op": "set_control", "id": "layout-0",  "key": "width",  "value": 64 },
    { "name": "resize-64h",   "op": "set_control", "id": "layout-0",  "key": "height", "value": 64,
      "measure": true,
      "bounds": { "module_count": { "min": 4 } } }
  ]
}
